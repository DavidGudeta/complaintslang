# SMTP settings for complaint notification emails
# Use real SMTP credentials for delivery to actual email addresses.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="Complaints Portal"
SMTP_SECURE=false

# Optional Mailtrap settings for local development
# Set USE_MAILTRAP=true to enable Mailtrap explicitly.
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASSWORD=your-mailtrap-password
USE_MAILTRAP=false

# Optional: other environment values used by the server
# DB_USER=...
# DB_PASSWORD=...
# DB_CONNECTION_STRING=...
# JWT_SECRET=...
